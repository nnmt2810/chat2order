DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat2order
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
# AI: none = tắt (mặc định). google = Gemini qua Google AI Studio
LLM_PROVIDER=none
LLM_API_KEY=
# Lấy đúng tên model hiện hành trong danh sách của Google AI Studio, tên model thay đổi thường xuyên
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=1024
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
WORKER_ENABLED=true
BATCH_QUIET_MS=4000